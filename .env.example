# Documentation only. Run make setup-env to create the private .env safely.
# Exactly these three keys are accepted. Values must be unquoted base64url-safe
# strings of 32-128 characters; setup generates 24 random bytes per role.
# Do not source .env in a shell or copy credentials into frontend environment files.
# Existing legacy values are imported unchanged; conflicting values fail closed.
POSTGRES_ADMIN_PASSWORD=<generated-by-setup-env>
POSTGRES_MIGRATOR_PASSWORD=<generated-by-setup-env>
POSTGRES_RUNTIME_PASSWORD=<generated-by-setup-env>
